    {
      "item_id": "expectation_25466da3e82e2dbe01deb7dfe767b2a62508500c075da5b94aabf5abb5c3f8d9",
      "item_type": "expectation",
      "source_text": "In an encrypted email to co-conspirator Phantom Phreak, Belford stating that he is expecting a payday of at least $25 million",
