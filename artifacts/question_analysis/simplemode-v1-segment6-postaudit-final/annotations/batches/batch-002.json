    },
    {
      "item_id": "expectation_3bf37a3d24183a4dda232dd93171b97a15a7d631cbe0b84c38d832c1744c9a04",
      "item_type": "expectation",
      "source_text": "Identifies Margo Wallace (margo.wallace@ellingson.com) as having communicated with Belford about the plan.",
      "text_sha256": "55fa1c07819ccb0bdaa0c7487700c88aa772a8f5b17ab9880f237eb83a8c1cd2"
    },
    {
      "item_id": "expectation_45d9ced331283e8958f492edbc19b1031f6a0d3846b23d04873751bd295d94a7",
      "item_type": "expectation",
      "source_text": "Belford referring to having a rabbit's foot USB as an insurance policy",
