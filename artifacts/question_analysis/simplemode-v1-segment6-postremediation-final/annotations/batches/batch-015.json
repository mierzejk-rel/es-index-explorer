      "text_sha256": "15cdb07283f4803b0522c08454c7015ea8e2f79bf33e629d1eb0fe89b7c85792"
    },
    {
      "item_id": "variant_8301d6634a5a402488b85c0fa6f7c3da583275d57a30fa772666ee47cb5881f8",
      "item_type": "question",
      "source_text": "Tell me about Debbie Lavelle's compliance email about health care provider meals and the subsequent discussions or communications regarding that email.",
      "text_sha256": "8eff2c925806dbe6547736d560a76776ecf31dc0a24124a2aa39e17abec5843f"
    },
    {
      "item_id": "variant_7e85b50d95411639e9ed3aac9c58ef5d875d70a41fab66b809e3e500c02d0f98",
      "item_type": "question",
      "source_text": "Are 'Phantom Phreak' (phantomphreak@ghostline.com) the teenage hacker and 'Phantom Phreak' (phantom.phreak@undergroundhax0r.net) who communicated with Belford the same person?",
      "text_sha256": "6df715850b1db57786d0b3cd6f77a22cd4657f0d68eae7b427e39c10e50ec773"
    }
