    },
    {
      "item_id": "expectation_c1d4985f78a485c14cbeac09905f610f2924147c57d855468562abc8fccdd806",
      "item_type": "expectation",
      "source_text": "An Exalgo lunch program was scheduled for Tuesday, January 10, 2012, with Dr. El-Mohandes, but it did not occur and was canceled.",
      "text_sha256": "7b269a2d65af1f38384f728a5a17d7a3db8583a8b7f94ef7f579f57e5b7c9ec5"
