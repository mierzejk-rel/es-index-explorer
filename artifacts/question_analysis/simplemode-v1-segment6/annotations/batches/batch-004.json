    },
    {
      "item_id": "expectation_3052b0f59236e9fbe0321c8af338800ae4283c22009c712cfd090dd62f45c9a7",
      "item_type": "expectation",
      "source_text": "In 2010, Dr. Argoff was reported to be a paid consultant for Endo, on the speakers bureau for Endo, receive grant or research support from Endo, and receive honoraria from Endo.",
      "text_sha256": "a6dab161a506591e77e229c74d6e87c9fe02d1255c075931a94d911707726a77"
    },
    {
      "item_id": "expectation_99fa5b016fee67a2642d8d2ad01b8ee8a131452607e0cd27b39c79b80201b54a",
      "item_type": "expectation",
      "source_text": "Cites email titled 'Go Dark' mentioning the FBI closing in and instructing Wallace to 'use the escape plan now'.",
      "text_sha256": "82e09a6ecd306ec12ad2cfa35adca368e5e374e859c5c4ff9143c6e12b16cfe4"
    },
    {
      "item_id": "expectation_4812824fa3a75e8f46d4c5b144378dddabd0ea8644aa363722178a38d81d5ee1",
      "item_type": "expectation",
      "source_text": "Cites potential compromise of employee data including SSNs.",
      "text_sha256": "b9fe4451dbadcaf21f364b131a74ff499f42644a34500e2794ade81e5656a794"
    },
    {
      "item_id": "expectation_93ff1d26131088effcc69583a520d5e50cc6aaa328bc856351cefc128e42700f",
      "item_type": "expectation",
      "source_text": "In an October 18, 1995, email to Margo Wallace, Belford stating that, at the same time the following day (October 19, 1995), they will be $25 million richer.",
      "text_sha256": "d78d2bdbd41085252a4a0e33b1fd0ca5fb335c725cc156060c8cf62d350b4886"
    },
    {
      "item_id": "expectation_059ba7fc872180e7b98e00171f74b401d28b7b93ff49208d7be03e0157ab4a25",
      "item_type": "expectation",
      "source_text": "Matt Brown (Covidien) email to Dr. El-Mohandes reminding of the upcoming Exalgo dinner program, noting that attendees are excited to talk about the Doctor's use of Exalgo and how it has helped his patients.",
      "text_sha256": "1d4b70c25629dfc5cdaff356632fd0ac07a74b1554aed87953d70ebd79d9515b"
    },
    {
