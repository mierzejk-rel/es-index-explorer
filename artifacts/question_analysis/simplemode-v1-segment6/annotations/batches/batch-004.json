    },
    {
      "item_id": "variant_d3aeee2c40fc2ef6c1467684c9e2220cc8182fd5f2b8cb66170eeb6e6c3ea52c",
      "item_type": "question",
      "source_text": "List the ways in which Covidien/Mallinckrodt engaged Dr. Charles Argoff to work with them",
